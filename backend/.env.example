# Port for the Node.js server (Render automatically injects PORT)
PORT=5000

# MongoDB Atlas connection string (Remember to whitelist 0.0.0.0/0 in MongoDB Atlas Network Access)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/kirana_khaata?retryWrites=true&w=majority

# Secret key for JWT signing & verification
JWT_SECRET=kirana_smart_khaata_secure_jwt_secret_key_2026

# Only needed on local Windows machines with SSL certificate inspection/proxy
# NODE_TLS_REJECT_UNAUTHORIZED=0
